#compdef wyrm
# Zsh completion for wyrm.
#
# Install: place this file (named exactly "_wyrm") on your $fpath, e.g.
#   fpath+=(/path/to/this/directory)
#   autoload -U compinit && compinit
# `brew install jskoll/tap/wyrm` installs it automatically.
#
# wyrm uses git-style subcommands (`wyrm kill`, `wyrm list`, ...). Dynamic
# completions shell out to wyrm itself, reusing its own config discovery and
# tmux session listing rather than reimplementing them here:
#   -config      -> `wyrm list-configs`      (local + shared config file paths)
#   -format      -> static: table json toml names
#   first token  -> subcommands + `wyrm list -format names` (running session
#                   names, since a bare `wyrm <name>` attaches by name)

_wyrm() {
    local -a subcommands
    subcommands=(
        'up:build or attach the current folder'\''s session'
        'restart:stop the session and build it again from the config'
        'kill:destroy the session (runs on_project_exit)'
        'pick:fuzzy-pick a running session to attach to'
        'tui:full-screen session-management TUI'
        'save:save the running session layout as a config for this folder'
        'edit:open the resolved config in $EDITOR'
        'validate:check the effective config without building a session'
        'status:print agent status across sessions'
        'send:send command or keys to target session/window/pane'
        'list:list running tmux sessions non-interactively'
        'list-configs:list candidate config file paths'
        'migrate-config:move the local config into the shared config directory'
        'clone:git clone, then build and attach a session'
        'init:scaffold a project config interactively or from a template'
        'selfupdate:download and install the latest release'
        'setup-tmux:generate or append recommended tmux popup configuration'
        'doctor:check tmux, settings, configs, and optional tools'
        'version:print version and exit'
        'help:show help'
    )

    _arguments -C \
        '1: :->command' \
        '*:: :->args'

    case "$state" in
        command)
            local -a sessions
            sessions=(${(f)"$(wyrm list -format names 2>/dev/null)"} ${(f)"$(wyrm list-configs -names 2>/dev/null)"})
            _describe -t commands 'subcommand' subcommands
            _describe -t sessions 'running session' sessions
            ;;
        args)
            case "$words[1]" in
                up)
                    _arguments '-config[config file path]:config file:->configs' \
                        '-n[dry run]' \
                        '-d[build the session without attaching]' \
                        '-var[set template variable (KEY=VALUE, can be repeated)]:variable:'
                    ;;
                edit)
                    _arguments '-config[config file path]:config file:->configs'
                    ;;
                validate)
                    _arguments '-config[config file path]:config file:->configs' \
                        '-strict[exit non-zero if the config has warnings]' \
                        '-var[set template variable (KEY=VALUE, can be repeated)]:variable:'
                    ;;
                send)
                    _arguments '-l[send exact characters (disable special key expansion)]' \
                        '-literal[send exact characters (disable special key expansion)]' \
                        '-n[do not append Enter keystroke]' \
                        '-no-enter[do not append Enter keystroke]' \
                        '-r[send raw tmux key symbols (e.g. C-c, Escape)]' \
                        '-raw[send raw tmux key symbols (e.g. C-c, Escape)]'
                    ;;
                setup-tmux)
                    _arguments '-a[append configuration directly to tmux.conf]' \
                        '-append[append configuration directly to tmux.conf]' \
                        '-w[append configuration directly to tmux.conf]' \
                        '-write[append configuration directly to tmux.conf]' \
                        '-key-pick[prefix key to open the wyrm pick popup]:key:' \
                        '-key-tui[prefix key to open the wyrm tui popup]:key:' \
                        '-status[include wyrm status bar integration]'
                    ;;
                restart)
                    _arguments '-config[config file path]:config file:->configs' \
                        '-all[restart all active tmux sessions]' \
                        '-a[restart all active tmux sessions]' \
                        '-yes[skip confirmation prompt]' \
                        '-y[skip confirmation prompt]' \
                        '-n[dry run]' \
                        '-d[skip attaching]' \
                        '-var[set template variable (KEY=VALUE, can be repeated)]:variable:'
                    ;;
                kill)
                    _arguments '-config[config file path]:config file:->configs' \
                        '-all[kill all active tmux sessions]' \
                        '-a[kill all active tmux sessions]' \
                        '-yes[skip confirmation prompt]' \
                        '-y[skip confirmation prompt]' \
                        '-n[dry run]'
                    ;;
                doctor)
                    _arguments '-strict[exit non-zero for warnings as well as errors]'
                    ;;
                clone)
                    _arguments '-no-start[clone without starting a session]' \
                        '-n[clone without starting a session]' \
                        '-yes[start without confirming the config'"'"'s shell commands]' \
                        '-y[start without confirming the config'"'"'s shell commands]'
                    ;;
                save)
                    _arguments '-config[config file path]:config file:->configs' \
                        '-o[config file path or - for stdout]:config file:->configs' \
                        '-stdout[print config to stdout]' \
                        '-n[dry run preview]' \
                        '-dry-run[dry run preview]'
                    ;;
                init)
                    _arguments '-config[config file path]:config file:->configs' \
                        '-template[starter template]:template:(node python go rust monorepo minimal)' \
                        '-t[starter template]:template:(node python go rust monorepo minimal)' \
                        '-force[overwrite existing config without prompting]' \
                        '-f[overwrite existing config without prompting]'
                    ;;
                status)
                    _arguments '-format[output format]:format:(text json tmux waybar sketchybar)' \
                        '-session[filter to session]:session:' \
                        '-v[verbose output]' \
                        '-watch[continuously stream status output]' \
                        '-w[continuously stream status output]' \
                        '-interval[polling interval in watch mode]:interval:'
                    ;;
                list)
                    _arguments '-format[output format]:format:(table json toml names)'
                    ;;
                list-configs)
                    _arguments '-names[list project names and aliases]'
                    ;;
                selfupdate)
                    _arguments '-check[report an available update without installing it]' \
                        '-version[install this version instead of the latest]:version:'
                    ;;
            esac
            if [[ "$state" == configs ]]; then
                local -a configs
                configs=(${(f)"$(wyrm list-configs 2>/dev/null)"})
                _describe 'config file' configs
            fi
            ;;
    esac
}

_wyrm "$@"
